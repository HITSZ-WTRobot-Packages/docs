---
import { Icon } from "astro-icon/components";

import type { ApiSymbol } from "../../lib/doxygen/schema";
import { apiAccessLabel, apiSymbolKindLabel, apiVirtualLabel } from "../../lib/site/view-models";

interface Props {
  symbol: ApiSymbol;
  headingLevel?: 3 | 4;
  showQualifiedName?: boolean;
  linkToCanonical?: boolean;
}

const { symbol, headingLevel = 3, showQualifiedName = true, linkToCanonical = false } = Astro.props;
const Heading = headingLevel === 4 ? "h4" : "h3";
const displayName = showQualifiedName ? symbol.qualifiedName : symbol.name;
const memberLabels = symbol.member
  ? [
      symbol.member.access ? apiAccessLabel(symbol.member.access) : null,
      symbol.member.static ? "静态" : null,
      apiVirtualLabel(symbol.member.virtual) || null,
      symbol.member.const ? "const" : null,
    ].filter((label): label is string => label !== null)
  : [];
---

<article class="wtr-symbol" id={linkToCanonical ? undefined : symbol.anchor}>
  <header>
    <Icon
      name={symbol.kind === "file" ? "lucide:file-code-2" : "lucide:code-2"}
      size="1rem"
      aria-hidden="true"
    />
    <div class="wtr-symbol-title">
      <Heading>
        {linkToCanonical ? <a href={`#${symbol.anchor}`}>{displayName}</a> : displayName}
      </Heading>
      <div class="wtr-symbol-meta" aria-label="符号属性">
        <span>{apiSymbolKindLabel(symbol.kind)}</span>
        {memberLabels.map((label) => <span>{label}</span>)}
      </div>
    </div>
  </header>
  {
    symbol.signature && (
      <pre aria-label={`${symbol.qualifiedName} 声明`} tabindex="0">
        <code>{symbol.signature}</code>
      </pre>
    )
  }
  {symbol.description ? <p>{symbol.description}</p> : <p class="wtr-muted">上游未提供说明。</p>}
  {
    symbol.enumValues.length > 0 && (
      <dl class="wtr-enum-values">
        {symbol.enumValues.map((value) => (
          <div>
            <dt>
              <code>
                {value.name}
                {value.initializer ? ` ${value.initializer}` : ""}
              </code>
            </dt>
            <dd>{value.description || "上游未提供说明。"}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    symbol.location && (
      <a
        class="wtr-source-location"
        href={symbol.location.sourceUrl}
        target="_blank"
        rel="noreferrer"
      >
        {symbol.location.path}
        {symbol.location.line ? `:${symbol.location.line}` : ""}
        <Icon name="lucide:external-link" size="0.9rem" aria-hidden="true" />
      </a>
    )
  }
</article>
