---
import { Icon } from "astro-icon/components";

import type { CatalogPackage } from "../../lib/catalog/schema";

interface Props {
  packageEntry: CatalogPackage;
  moduleHref: string;
}

const { packageEntry, moduleHref } = Astro.props;
---

<section class="wtr-package-summary" aria-label="软件包元数据">
  <dl class="wtr-metadata-grid">
    <div>
      <dt>软件包</dt>
      <dd><code>{packageEntry.pkgname}</code></dd>
    </div>
    <div>
      <dt>修订版本</dt>
      <dd><code>{packageEntry.revisionLabel}</code></dd>
    </div>
    <div>
      <dt>模块</dt>
      <dd><a href={moduleHref}>{packageEntry.moduleId}</a></dd>
    </div>
    <div>
      <dt>清单</dt>
      <dd><code>{packageEntry.manifestPath}</code></dd>
    </div>
  </dl>
  <a class="wtr-command-link" href={packageEntry.sourceUrl} target="_blank" rel="noreferrer">
    <Icon name="lucide:external-link" size="1rem" aria-hidden="true" />
    固定版本源码
  </a>
</section>
