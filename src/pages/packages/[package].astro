---
import DocumentationContent from "../../components/documentation/DocumentationContent.astro";
import PackageInstallCommand from "../../components/documentation/PackageInstallCommand.astro";
import Breadcrumbs from "../../components/portal/Breadcrumbs.astro";
import PagefindMetadata from "../../components/portal/PagefindMetadata.astro";
import PortalPage from "../../components/portal/PortalPage.astro";
import type { CatalogPackage } from "../../lib/catalog/schema";
import type { DocumentationPage } from "../../lib/markdown/documentation-schema";
import { sitePath } from "../../lib/paths/site-config";
import { buildPortalSidebar } from "../../lib/site/navigation";
import { loadPortalData } from "../../lib/site/portal-data";

interface Props {
  packageEntry: CatalogPackage;
  documentation: DocumentationPage;
}

export async function getStaticPaths() {
  const data = await loadPortalData();
  return data.catalog.packages.map((packageEntry) => {
    const documentation = data.documentation.pages.find(
      (page) => page.kind === "package" && page.packageSlug === packageEntry.slug,
    );
    if (!documentation) throw new Error(`Missing generated package data: ${packageEntry.pkgname}`);
    return { params: { package: packageEntry.slug }, props: { packageEntry, documentation } };
  });
}

const { packageEntry, documentation } = Astro.props;
const data = await loadPortalData();
const sidebar = buildPortalSidebar(data.catalog);
const moduleEntry = data.catalog.modules.find((module) => module.id === packageEntry.moduleId);
if (!moduleEntry) throw new Error(`Missing package module: ${packageEntry.moduleId}`);
---

<PortalPage
  title={packageEntry.pkgname}
  description={`${packageEntry.pkgname} ${packageEntry.revisionLabel} 软件包手册与依赖参考。`}
  sidebar={sidebar}
  rightSidebar={true}
>
  <PagefindMetadata module={packageEntry.moduleId} resultTypes={["package", "readme"]} />
  <Breadcrumbs
    items={[
      { label: "目录", href: sitePath(data.config.basePath) },
      {
        label: moduleEntry.displayName,
        href: sitePath(data.config.basePath, "modules", moduleEntry.slug),
      },
      { label: packageEntry.pkgname },
    ]}
  />

  <PackageInstallCommand packageName={packageEntry.pkgname} />
  <DocumentationContent page={documentation} />
</PortalPage>
