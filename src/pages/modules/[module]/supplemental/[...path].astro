---
import DocumentationContent from "../../../../components/documentation/DocumentationContent.astro";
import Breadcrumbs from "../../../../components/portal/Breadcrumbs.astro";
import PagefindMetadata from "../../../../components/portal/PagefindMetadata.astro";
import PortalPage from "../../../../components/portal/PortalPage.astro";
import type { CatalogModule } from "../../../../lib/catalog/schema";
import type { DocumentationPage } from "../../../../lib/markdown/documentation-schema";
import { sitePath } from "../../../../lib/paths/site-config";
import { buildPortalSidebar } from "../../../../lib/site/navigation";
import { loadPortalData } from "../../../../lib/site/portal-data";

interface Props {
  module: CatalogModule;
  documentation: DocumentationPage;
}

export async function getStaticPaths() {
  const data = await loadPortalData();
  return data.documentation.pages.flatMap((documentation) => {
    if (documentation.kind !== "supplemental") return [];
    const module = data.catalog.modules.find(
      (candidate) => candidate.id === documentation.moduleId,
    );
    if (!module) throw new Error(`Missing supplemental module: ${documentation.moduleId}`);
    const prefix = sitePath(data.config.basePath, "modules", module.slug, "supplemental");
    const suffix = documentation.route.slice(prefix.length).replace(/\/$/u, "");
    const routePath = suffix
      .split("/")
      .filter(Boolean)
      .map((segment) => decodeURIComponent(segment))
      .join("/");
    return [{ params: { module: module.slug, path: routePath }, props: { module, documentation } }];
  });
}

const { module, documentation } = Astro.props;
const data = await loadPortalData();
const sidebar = buildPortalSidebar(data.catalog);
---

<PortalPage
  title={documentation.title}
  description={`Supplemental documentation from ${module.displayName}.`}
  sidebar={sidebar}
>
  <PagefindMetadata module={module.id} resultTypes={["readme"]} />
  <Breadcrumbs
    items={[
      { label: "Catalog", href: sitePath(data.config.basePath) },
      { label: module.displayName, href: sitePath(data.config.basePath, "modules", module.slug) },
      { label: documentation.title },
    ]}
  />
  <DocumentationContent page={documentation} />
</PortalPage>
