{
  "name": "@hitsz-wtr/packages-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 astro dev",
    "build": "astro build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test",
    "sync": "bun run scripts/sync/sync-cli.ts",
    "generate:catalog": "bun run scripts/generate/catalog-cli.ts",
    "generate:readme": "bun run scripts/generate/readme-cli.ts",
    "generate:api": "bun run scripts/generate/api-cli.ts",
    "check:conventions": "bun run scripts/validation/check-conventions.ts",
    "check": "bun run check:conventions && bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fast-xml-parser": "^5.10.1",
    "fast-xml-validator": "^1.4.1",
    "github-slugger": "^2.0.0",
    "mrmime": "^2.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.7.1",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
